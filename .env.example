# Supabase (login gate + platform rankings cache)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (appl_… / goog_…)
# Product IDs: pro_monthly, pro_annual (Burnline Pro group)
# Entitlement: pro · Offering: default
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# UI-only Pro override (no store). Set false when testing real IAP.
EXPO_PUBLIC_DEV_PRO=false

# --- Burn spike remote monitor (Supabase Edge Function secrets + GitHub Actions) ---
# Set on Supabase functions (not EXPO_PUBLIC):
#   MONITOR_KEY_ENCRYPTION_SECRET=long-random-string
#   MONITOR_CRON_SECRET=long-random-string
# GitHub Actions repo secrets:
#   SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1
#   MONITOR_CRON_SECRET=<same as above>

# --- Supabase Auth URL configuration ---
# Site URL: limeboard://
# Redirect URLs: limeboard://auth/callback · limeboard://** · (Expo Go tunnel URI)

# --- Legal (App Store Connect metadata) ---
# Privacy: https://limeboard.app/privacy
# Terms:   https://limeboard.app/terms
# See public/legal/*.html and docs/STORE_SETUP.md
