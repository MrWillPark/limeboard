{
  "expo": {
    "name": "LimeBoard",
    "slug": "limeboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "limeboard",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.limeboard.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0E0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.limeboard.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E0D"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.limeboard.mobile.widgets",
          "groupIdentifier": "group.app.limeboard.mobile",
          "widgets": [
            {
              "name": "BalanceWidget",
              "displayName": "LimeBoard Balance",
              "description": "OpenRouter credit balance, spend, and runway at a glance.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            },
            {
              "name": "DeskMonitorWidget",
              "displayName": "Desk Monitor",
              "description": "Live token burn or spend velocity for your desk setup.",
              "contentMarginsDisabled": true,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "systemExtraLarge"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f30e8a6-6082-4de1-ae0f-46339d2acdef",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.limeboard.mobile.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.limeboard.mobile"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "willparksf"
  }
}
